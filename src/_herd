# Zsh completion for Shepherd commands.

_herd_complete_subcommand() {
    local command="$words[2]"
    case "$command" in
        discover)
            _values 'discover options' 'guix-daemon'
            ;;
        schedule)
            _values 'schedule options' 'mcron' 'timer'
            ;;
        set-http-proxy)
            _values 'set-http-proxy options' 'guix-daemon'
            ;;
        *)
            local -a services
            services=(${(f)"$(herd status 2>/dev/null | grep '^ +\|^ -\| \*' | cut -d ' ' -f3)"})
            _values 'services' $services
            ;;
    esac
}

_herd_complete_3() {
    local command="$words[3]"
    case "$command" in
        guix-daemon)
            _values 'options' 'on' 'off'
            ;;
        *)
            ;;
    esac
}

_herd() {
    local -a _herd_subcommands_list
    _herd_subcommands_list=(
        'configuration:Show configuration'
        'disable:Disable a service'
        'discover:Discover services'
        'doc:Show documentation'
        'enable:Enable a service'
        'help:Show help'
        'restart:Restart a service'
        'schedule:Schedule tasks'
        'set-http-proxy:Set HTTP proxy'
        'spawn:Spawn a service'
        'start:Start a service'
        'status:Show service status'
        'stop:Stop a service'
        'trigger:Trigger an action'
    )

    case $CURRENT in
        2)
            _describe 'herd commands' _herd_subcommands_list
            ;;
        3)
            _herd_complete_subcommand
            ;;
        4)
            _herd_complete_3
            ;;
    esac
}

_herd "$@"
